# ─── Required ────────────────────────────────────────────────────────────────
# MongoDB connection string. Never commit the real value.
MONGODB_URI=mongodb://127.0.0.1:27017
# Comma-separated owner phone numbers, international format, digits only (no "+").
# Owners are verified from this list only; the database cannot grant owner rights.
# If WhatsApp identifies you by a LID, add the full id too, e.g. 15551234567,98765432101@lid
OWNER_NUMBERS=15551234567

# ─── Identity ────────────────────────────────────────────────────────────────
BOT_NAME=UtilityBot
# 1-3 symbol characters (letters/digits are rejected).
BOT_PREFIX=,
# private = only the owner gets replies (recommended; there is no longer a way to allow-list
#           other users, since the user-management commands were removed)
# public  = anyone who messages the linked account can use ,sticker (,delete/,settings stay owner-only)
BOT_MODE=private
ALLOW_GROUP_COMMANDS=true
# Optional: an image (png/jpg/webp) attached to every command reply (short replies become a
# single image+caption message; long ones get the image, then the full text separately).
BRAND_IMAGE_PATH=

# ─── Database ────────────────────────────────────────────────────────────────
MONGODB_DB=whatsapp_bot

# ─── WhatsApp session ────────────────────────────────────────────────────────
# file  = session files in AUTH_DIR (mount a volume!)   mongo = stored in MongoDB (encrypted if DATA_ENCRYPTION_KEY set)
AUTH_STORE=file
AUTH_DIR=./data/auth
# Optional: link with an 8-character pairing code instead of scanning a QR code
# (enter the code at WhatsApp > Linked devices > Link with phone number)
PAIRING_PHONE_NUMBER=
# Optional: also save the QR code as a PNG at this path (e.g. ./data/qr.png) — handy when you
# cannot see the terminal (Docker, a remote host). The file is overwritten on every new QR and
# is not deleted automatically; remove it once you have scanned it.
QR_IMAGE_PATH=

# ─── Deleted-message monitoring (,delete / ,settings delete) ─────────────────
# Encrypts cached messages/media/session at rest (AES-256-GCM). Generate: openssl rand -hex 32
# Losing this key makes encrypted data unreadable. Back it up separately from the database.
DATA_ENCRYPTION_KEY=
# Global kill switches. false = ,delete on can never capture that kind of content, however it's toggled.
ALLOW_CONTENT_LOGGING=true
ALLOW_MEDIA_CACHING=true
# Starting state for monitoring. off (default) = ,delete on must be run at least once. Setting
# this to meta/full/media makes monitoring active from first boot, for every chat — still with
# the same visible "monitoring is ON" notice the first message it captures in each chat, and the
# owner is notified privately on deletion either way. The owner can change this live with
# ,delete on|off|status without restarting, so this only matters as the deploy-time starting value.
DEFAULT_ARCHIVE_MODE=off
# How long a captured message stays available in case it gets deleted (1-168 hours)
CACHE_TTL_HOURS=24
RETENTION_SWEEP_MS=600000

# ─── Stickers (,sticker) ──────────────────────────────────────────────────────
# Needs the `ffmpeg` binary on PATH for video/GIF stickers (static image stickers work without
# it, via the `sharp` package). Install it on the host, or use the provided Docker image.
MEDIA_DIR=./data/media
MAX_MEDIA_MB=25
# Optional: shown under every sticker ,sticker creates (defaults to BOT_NAME if left empty).
STICKER_PACK_NAME=
STICKER_PACK_AUTHOR=

# ─── Rate limiting / spam prevention (the owner is exempt) ───────────────────
RATE_LIMIT_MAX=8
RATE_LIMIT_WINDOW_MS=10000
RATE_LIMIT_COOLDOWN_MS=30000
# After this many cooldowns the sender is muted for RATE_LIMIT_MUTE_MS
RATE_LIMIT_STRIKES=3
RATE_LIMIT_MUTE_MS=600000

# ─── Operations ──────────────────────────────────────────────────────────────
# Health endpoint: GET /healthz (liveness), GET /readyz (Mongo + WhatsApp). 0 disables it.
HEALTH_PORT=3000
HEALTH_HOST=127.0.0.1
# trace|debug|info|warn|error|fatal|silent. Message text and credentials are always redacted.
LOG_LEVEL=info
BAILEYS_LOG_LEVEL=warn
# Human-readable logs for development (needs `npm i` with dev dependencies)
LOG_PRETTY=false
# Send the owner a WhatsApp message (de-duplicated, max 5/hour) when an unexpected error occurs
ERROR_NOTIFY_OWNER=true
