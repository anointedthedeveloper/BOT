    "pino": "^10.4.0",
    "qrcode": "1.5.4",
    "qrcode-terminal": "^0.12.0",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "mongodb-memory-server": "^11.3.0",
    "pino-pretty": "^13.2.0"
  }
