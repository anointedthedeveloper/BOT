{
  "name": "whatsapp-utility-bot",
  "version": "1.0.0",
  "description": "WhatsApp deleted-message monitoring & sticker bot (Baileys + MongoDB)",
  "type": "module",
  "main": "src/index.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
